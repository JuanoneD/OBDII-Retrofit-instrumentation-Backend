# Modelo das configurações do backend.
# Copie este arquivo com o nome ".env" e preencha os valores.
# O .env NÃO vai para o GitHub, porque guarda senhas.

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS: endereços do Frontend autorizados a chamar o backend ---
# Em produção, inclua o domínio da Vercel, separado por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Banco MySQL na AWS ---
# Deixe DB_HOST vazio para usar o banco local (SQLite).
DB_HOST=
DB_PORT=3306
DB_NAME=obdii
DB_USER=backend_user
DB_PASSWORD=
# Certificado SSL da AWS, baixado em:
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
DB_SSL_CA=global-bundle.pem
