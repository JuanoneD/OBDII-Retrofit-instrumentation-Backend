# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o GitHub.

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção, ex.: DJANGO_CSRF_TRUSTED_ORIGINS=https://api.seudominio.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- CORS (domínios do Frontend) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Em produção, adicione o domínio da Vercel, ex.: https://obdii-frontend.vercel.app

CORS_ALLOW_VERCEL_PREVIEWS=True

# --- Banco MySQL na AWS (RDS) ---
# Deixe DB_HOST vazio para usar SQLite local (desenvolvimento).
DB_HOST=
DB_PORT=3306
DB_NAME=obdii
DB_USER=
DB_PASSWORD=
# Certificado SSL da AWS (baixe em https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem)
DB_SSL_CA=global-bundle.pem
